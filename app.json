{
  "expo": {
    "name": "Piggo",
    "slug": "piggo-finance",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon-legacy.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/logo-porquinho.png",
      "resizeMode": "contain",
      "backgroundColor": "#92C62A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.decioduarte.piggo"
    },
    "android": {
      "package": "com.decioduarte.piggo",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-foreground.png",
        "backgroundColor": "#92C62A",
        "monochromeImage": "./src/assets/icon-monochrome.png"
      },
      "icon": "./src/assets/icon-legacy.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["@react-native-community/datetimepicker"],
    "extra": {
      "eas": {
        "projectId": "1581e42a-c7b5-4101-9df0-70b121d69e6c"
      }
    },
    "owner": "deciodev"
  }
}
